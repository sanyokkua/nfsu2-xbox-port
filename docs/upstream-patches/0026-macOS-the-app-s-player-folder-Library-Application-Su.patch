From deafe2f8243f36f8360f5b4d83234240a54378a3 Mon Sep 17 00:00:00 2001
From: Oleksandr Kostenko <sanyokkua@gmail.com>
Date: Thu, 19 Nov 2026 10:50:14 +0100
Subject: [PATCH] macOS: the app's player folder (~/Library/Application
 Support/NFS Underground 2)

Without NFSU2_GAME_DIR the host uses game/ (the installed disc), saves/
(XDG_DATA_HOME), cache/ (XDG_CACHE_HOME), player/ (working directory:
settings.ini, nfsu2x_options.txt) and logs/nfsu2.log (rotated, when not on a
terminal). No disc installed: a message pointing at the installer.
---
 CMakeLists.txt           |   2 +-
 src/apple/apple_main.c   |  11 ++++
 src/apple/apple_player.c | 114 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 126 insertions(+), 1 deletion(-)
 create mode 100644 src/apple/apple_player.c

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0e8b5ad..10cd665 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -86,7 +86,7 @@ if(APPLE)
     target_sources(${PROJECT_NAME} PRIVATE src/apple/apple_main.c src/apple/apple_game_state.c src/apple/apple_perf.m
                                            src/apple/apple_keyboard.c src/apple/apple_textures.m
                                            src/apple/apple_prompts.m src/apple/apple_window.m
-                                           src/apple/apple_menu.m)
+                                           src/apple/apple_menu.m src/apple/apple_player.c)
     target_compile_definitions(${PROJECT_NAME} PRIVATE NFSU2_APPLE_TEXTURES=1)
     set_source_files_properties(src/apple/apple_textures.m src/apple/apple_prompts.m src/apple/apple_window.m
                                 src/apple/apple_menu.m
diff --git a/src/apple/apple_main.c b/src/apple/apple_main.c
index bd1c8b6..f8718c4 100644
--- a/src/apple/apple_main.c
+++ b/src/apple/apple_main.c
@@ -30,6 +30,8 @@
 #if !TARGET_OS_IPHONE
 #include <SDL_syswm.h>
 #include "apple_menu.h"
+void apple_player_setup(void);                 /* apple_player.c */
+int apple_player_has_game(void);
 void apple_window_full_panel(void *nswindow);   /* apple_window.m */
 void apple_pads_background(void);              /* apple_window.m */
 void apple_window_restore(void);
@@ -305,6 +307,9 @@ int main(int argc, char **argv)
 
     (void)argc;
     (void)argv;
+#if !TARGET_OS_IPHONE
+    apple_player_setup();               /* the player folder, the log */
+#endif
 #if TARGET_OS_IPHONE
     ios_host_setup();                   /* paths, settings file, log */
     SDL_SetHint(SDL_HINT_ORIENTATIONS, "LandscapeLeft LandscapeRight");
@@ -325,6 +330,12 @@ int main(int argc, char **argv)
         return 1;
     }
 #if !TARGET_OS_IPHONE
+    if (!apple_player_has_game()) {
+        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "NFS Underground 2",
+                                 "The game's files are not installed. Open \"NFS Underground 2 Installer\" "
+                                 "and choose your disc image.", NULL);
+        return 1;
+    }
     apple_settings_load();                  /* settings.ini: env defaults */
 #endif
 #if TARGET_OS_IPHONE
diff --git a/src/apple/apple_player.c b/src/apple/apple_player.c
new file mode 100644
index 0000000..a946bfb
--- /dev/null
+++ b/src/apple/apple_player.c
@@ -0,0 +1,114 @@
+/*
+ * apple_player.c -- the player folder of the Mac app.
+ *
+ * When NFSU2_GAME_DIR is not set (the app opened from Finder), everything the
+ * game reads and writes lives in ~/Library/Application Support/NFS Underground 2:
+ *
+ *   game/      the player's disc, put there by the installer (the game's own
+ *              saves, UDATA/, are written here too)
+ *   saves/     the kernel's partitions (XDG_DATA_HOME)
+ *   cache/     shader cache (XDG_CACHE_HOME)
+ *   player/    the working directory: settings.ini (Settings window) and
+ *              nfsu2x_options.txt (the game's Options rows)
+ *   logs/      nfsu2.log (stdout and stderr when not on a terminal), the five
+ *              before it as nfsu2.log.1 .. .5
+ *
+ * Variables already set win (tests, tools/play.sh).
+ */
+#include <TargetConditionals.h>
+#if defined(__APPLE__) && !TARGET_OS_IPHONE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#define PLAYER_ROOT "/Library/Application Support/NFS Underground 2"
+
+static void mkdirs(const char *path)
+{
+    char p[PATH_MAX];
+    char *s;
+
+    snprintf(p, sizeof p, "%s", path);
+    for (s = p + 1; *s; s++)
+        if (*s == '/') {
+            *s = 0;
+            mkdir(p, 0755);
+            *s = '/';
+        }
+    mkdir(p, 0755);
+}
+
+static void sub(char *out, size_t n, const char *root, const char *name)
+{
+    snprintf(out, n, "%s/%s", root, name);
+    mkdirs(out);
+}
+
+static void open_log(const char *logs)
+{
+    char a[PATH_MAX], b[PATH_MAX];
+    int i, fd;
+    time_t t = time(NULL);
+
+    for (i = 4; i >= 0; i--) {
+        if (i)
+            snprintf(a, sizeof a, "%s/nfsu2.log.%d", logs, i);
+        else
+            snprintf(a, sizeof a, "%s/nfsu2.log", logs);
+        snprintf(b, sizeof b, "%s/nfsu2.log.%d", logs, i + 1);
+        rename(a, b);
+    }
+    snprintf(a, sizeof a, "%s/nfsu2.log", logs);
+    fd = open(a, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd < 0)
+        return;
+    dup2(fd, 1);
+    dup2(fd, 2);
+    close(fd);
+    setvbuf(stdout, NULL, _IOLBF, 0);
+    printf("=== %s", ctime(&t));
+}
+
+void apple_player_setup(void)
+{
+    const char *home = getenv("HOME");
+    char root[PATH_MAX], dir[PATH_MAX];
+
+    if (getenv("NFSU2_GAME_DIR") || !home)
+        return;                             /* a test or tools/play.sh: its own folders */
+    snprintf(root, sizeof root, "%s" PLAYER_ROOT, home);
+    sub(dir, sizeof dir, root, "logs");
+    if (!isatty(2))
+        open_log(dir);
+    snprintf(dir, sizeof dir, "%s/game", root);
+    setenv("NFSU2_GAME_DIR", dir, 1);
+    sub(dir, sizeof dir, root, "saves");
+    setenv("XDG_DATA_HOME", dir, 0);
+    sub(dir, sizeof dir, root, "cache");
+    setenv("XDG_CACHE_HOME", dir, 0);
+    sub(dir, sizeof dir, root, "player");
+    if (chdir(dir) != 0)
+        fprintf(stderr, "[player] cannot enter %s: %s\n", dir, strerror(errno));
+    fprintf(stderr, "[player] %s (game, saves, cache, player, logs)\n", root);
+}
+
+/* The installed disc: 1 if game/default.xbe is there. */
+int apple_player_has_game(void)
+{
+    char p[PATH_MAX];
+    const char *g = getenv("NFSU2_GAME_DIR");
+
+    if (!g)
+        return 1;
+    snprintf(p, sizeof p, "%s/default.xbe", g);
+    return access(p, R_OK) == 0;
+}
+
+#endif
-- 
